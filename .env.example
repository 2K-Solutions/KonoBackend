# Copy to .env and fill in real values. .env is git-ignored.
# Read by docker-compose (database/pgAdmin) and by the API on startup.
# In production, set these as real environment variables instead of using a file.

# --- Docker Compose ---
POSTGRES_USER=kono
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kono
PGADMIN_DEFAULT_EMAIL=postgres@pg.com
PGADMIN_DEFAULT_PASSWORD=change-me

# --- API (double underscore = nested config key, e.g. Jwt__SigningKey -> Jwt:SigningKey) ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=kono;Username=kono;Password=change-me
# At least 32 characters; generate with: openssl rand -base64 48
Jwt__SigningKey=
# Comma-separated list of owner emails that get the isAdmin claim
Admin__Emails=
Admin__Password=
